OPENAI_API_KEY=
ELEVENLABS_API_KEY=

# Realtime call context API
BACKEND_API_BASE_URL=https://api.mirrorsoul64.com
AI_INTERNAL_API_KEY=
BACKEND_CALL_CONTEXT_TIMEOUT_SECONDS=5
# Transport errors and HTTP 502/504 are retried; 404/409/401 are not.
BACKEND_CALL_CONTEXT_MAX_ATTEMPTS=2
BACKEND_CALL_CONTEXT_RETRY_BACKOFF_SECONDS=0.2
# Contexts of calls without an active WebRTC session expire after this TTL.
CALL_CONTEXT_CACHE_TTL_SECONDS=600
CALL_CONTEXT_CACHE_MAX_ENTRIES=500

# Member memories live only on the AI API server. The call server searches
# them through its internal API (private IP of the AI EC2 in the same VPC).
# The key must match RAG_INTERNAL_API_KEY on the AI API server.
RAG_SEARCH_BASE_URL=http://10.0.1.201:8000
RAG_INTERNAL_API_KEY=
RAG_SEARCH_TIMEOUT_SECONDS=3

WEBRTC_STUN_URL=stun:stun.l.google.com:19302
WEBRTC_TURN_URL=
WEBRTC_TURN_USERNAME=
WEBRTC_TURN_CREDENTIAL=

REALTIME_VAD_ENERGY_THRESHOLD=450
REALTIME_VAD_SILENCE_SECONDS=0.8
REALTIME_VAD_MIN_SPEECH_SECONDS=0.4
REALTIME_VAD_MAX_SPEECH_SECONDS=15

DITTO_CALL_SERVICE_URL=
DITTO_CALL_SERVICE_API_KEY=
DITTO_CALL_TIMEOUT_SECONDS=300
DITTO_CALL_MAX_RESPONSE_BYTES=104857600
DITTO_CALL_RETRY_ATTEMPTS=3
DITTO_CALL_RETRY_BASE_SECONDS=0.5
DITTO_CALL_ALLOW_INSECURE_HTTP=false
DITTO_CALL_S3_BUCKET=
DITTO_CALL_FACE_RESULT_PREFIX=face-results
DITTO_CALL_LOCAL_PORTRAIT_PATH=
DITTO_CALL_LOCAL_PROFILE_PATH=
REALTIME_VIDEO_WIDTH=540
REALTIME_VIDEO_HEIGHT=960
REALTIME_VIDEO_FPS=25
