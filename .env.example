OPENAI_API_KEY=
ELEVENLABS_API_KEY=

DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USERNAME=
DB_PASSWORD=

AWS_REGION=ap-northeast-2
# Required on external GPU hosts when no AWS IAM role is attached.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SQS_VOICE_TRAINING_QUEUE_URL=
AWS_SQS_FACE_TRAINING_QUEUE_URL=
AWS_SQS_FACE_TRAINING_RESULT_QUEUE_URL=
AWS_S3_BUCKET=mirrorsoul-storage-64

EMBEDDING_MODEL=text-embedding-3-small
RAG_DB_PATH=./rag_store/chroma
RAG_COLLECTION_NAME=mirror_soul_memories

AI_SERVER_HOST=0.0.0.0
AI_SERVER_PORT=8000

WEBRTC_STUN_URL=stun:stun.l.google.com:19302
WEBRTC_TURN_URL=
WEBRTC_TURN_USERNAME=
WEBRTC_TURN_CREDENTIAL=

# Realtime voice call
REALTIME_VAD_ENERGY_THRESHOLD=900
REALTIME_VAD_SILENCE_SECONDS=0.8
REALTIME_VAD_MIN_SPEECH_SECONDS=0.7
REALTIME_VAD_MAX_SPEECH_SECONDS=15
REALTIME_VAD_STARTUP_GRACE_SECONDS=1.5

# Voice training worker
VOICE_TRAINING_WAIT_SECONDS=20
VOICE_TRAINING_VISIBILITY_TIMEOUT=600
VOICE_TRAINING_DELETE_FAILED_MESSAGES=true

# Face training worker
FACE_TRAINING_WORKSPACE_DIR=tmp/face_training
FACE_TRAINING_WAIT_SECONDS=20
FACE_TRAINING_VISIBILITY_TIMEOUT=900
FACE_TRAINING_VISIBILITY_HEARTBEAT_SECONDS=60
FACE_TRAINING_POLL_INTERVAL_SECONDS=0
FACE_TRAINING_DELETE_INVALID_MESSAGES=true
FACE_TRAINING_DELETE_FAILED_MESSAGES=false
FACE_TRAINING_RESULT_PREFIX=face-results
FACE_TRAINING_ENGINE=ditto
FACE_TRAINING_ENGINE_VERSION=v0.4-hubert-pytorch
FACE_TRAINING_DITTO_CROP_SCALE=2.3
FACE_TRAINING_DITTO_SMO_K_D=5
FACE_TRAINING_DITTO_SAMPLING_TIMESTEPS=50
FACE_TRAINING_DITTO_REPO_DIR=/shareHost/C084003-ditto/ditto-talkinghead
FACE_TRAINING_DITTO_PYTHON=/shareHost/C084003-ditto/conda-env/bin/python
FACE_TRAINING_DITTO_DATA_ROOT=
FACE_TRAINING_DITTO_CONFIG_PATH=
FACE_TRAINING_DITTO_TIMEOUT_SECONDS=1800
FACE_TRAINING_DITTO_SEED=1024
FACE_TRAINING_DITTO_FFMPEG_DIR=/opt/conda/bin
FACE_TRAINING_MAX_FILE_SIZE_BYTES=104857600
FACE_TRAINING_MIN_DURATION_SECONDS=1
FACE_TRAINING_MAX_DURATION_SECONDS=120
FACE_TRAINING_MIN_RESOLUTION=256
FACE_TRAINING_EXTRACTION_FPS=2
FACE_TRAINING_MAX_EXTRACTED_FRAMES=120
FACE_TRAINING_MIN_SHARPNESS=40
FACE_TRAINING_MIN_BRIGHTNESS=40
FACE_TRAINING_MAX_BRIGHTNESS=215
FACE_TRAINING_MIN_CONTRAST=18
FACE_TRAINING_MIN_FACE_COVERAGE=0.05
FACE_TRAINING_MAX_FACE_COVERAGE=0.70
FACE_TRAINING_MAX_CENTER_OFFSET=0.55
FACE_TRAINING_RUN_LIVEPORTRAIT=false
FACE_TRAINING_LIVEPORTRAIT_REPO_DIR=/workspace/mirror-soul-face/liveportrait
FACE_TRAINING_LIVEPORTRAIT_PYTHON=/opt/conda/envs/mirrorsoul-face/bin/python
FACE_TRAINING_LIVEPORTRAIT_TIMEOUT_SECONDS=900
FACE_TRAINING_LIVEPORTRAIT_DRIVING_OPTION=expression-friendly
FACE_TRAINING_LIVEPORTRAIT_DRIVING_MULTIPLIER=1.0
FACE_TRAINING_LIVEPORTRAIT_SOURCE_MAX_DIM=1280
FACE_TRAINING_LIVEPORTRAIT_SOURCE_DIVISION=2
FACE_TRAINING_LIVEPORTRAIT_CROP_SCALE=
FACE_TRAINING_MEMBER_VOICE_PREVIEW_ENABLE=false
FACE_TRAINING_MEMBER_VOICE_PREVIEW_TEXT=안녕하세요. 처음 뵙겠습니다.
FACE_TRAINING_MUSETALK_REPO_DIR=/shareHost/C084003-musetalk/MuseTalk
FACE_TRAINING_MUSETALK_PYTHON=/shareHost/C084003-musetalk/conda-env/bin/python
FACE_TRAINING_MUSETALK_TIMEOUT_SECONDS=900
FACE_TRAINING_MUSETALK_BBOX_SHIFT=0
FACE_TRAINING_MUSETALK_FFMPEG_DIR=/opt/conda/bin
FACE_TRAINING_NATURAL_MOTION_ENABLE=true
FACE_TRAINING_NATURAL_MOTION_FPS=25
FACE_TRAINING_NATURAL_MOTION_CRF=18
FACE_TRAINING_NATURAL_MOTION_MIN_FRONT_RATIO=0.60
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe

# Ditto GPU rendering service
DITTO_SERVICE_API_KEY=
DITTO_SERVICE_HOST=127.0.0.1
DITTO_SERVICE_PORT=8080
DITTO_SERVICE_REPO_DIR=/shareHost/C084003-ditto/ditto-talkinghead
DITTO_SERVICE_DATA_ROOT=
DITTO_SERVICE_CONFIG_PATH=
DITTO_SERVICE_FFMPEG_DIR=/opt/conda/bin
DITTO_SERVICE_MAX_PORTRAIT_BYTES=10485760
DITTO_SERVICE_MAX_AUDIO_BYTES=26214400
DITTO_SERVICE_REQUIRE_CUDA=true
DITTO_SERVICE_SSL_CERTFILE=
DITTO_SERVICE_SSL_KEYFILE=

# Face identity similarity (InsightFace public weights: non-commercial research only)
FACE_SIMILARITY_ENABLE=false
FACE_SIMILARITY_REQUIRED=false
FACE_SIMILARITY_ACCEPT_INSIGHTFACE_NON_COMMERCIAL_LICENSE=false
FACE_SIMILARITY_MODEL=buffalo_l
FACE_SIMILARITY_MODEL_ROOT=/workspace/mirror-soul-face/insightface
FACE_SIMILARITY_PROVIDERS=CUDAExecutionProvider,CPUExecutionProvider
FACE_SIMILARITY_SAMPLE_COUNT=16
FACE_SIMILARITY_COSINE_LOW=0.30
FACE_SIMILARITY_COSINE_HIGH=0.70
FACE_SIMILARITY_MAX_SCORE=95
FACE_SIMILARITY_MIN_DETECTION_RATE=0.75
FACE_SIMILARITY_IDENTITY_WEIGHT=0.65
FACE_SIMILARITY_RENDER_QUALITY_WEIGHT=0.35
FACE_SIMILARITY_MIN_TEMPORAL_CONSISTENCY=0.60
FACE_SIMILARITY_STABILITY_FLOOR=0.70
FACE_SIMILARITY_CALIBRATION_VERSION=provisional-v1
FACE_SIMILARITY_CALIBRATED=false

# Clone similarity scoring
CLONE_SIMILARITY_ENABLE_SPEAKER_EMBEDDING=false
CLONE_SIMILARITY_EXPECTED_VOICE_SAMPLES=5
CLONE_SIMILARITY_EXCELLENT_VOICE_SAMPLES=20
CLONE_SIMILARITY_EXPECTED_INTERVIEWS=5
CLONE_SIMILARITY_EXCELLENT_INTERVIEWS=15
CLONE_SIMILARITY_EXPECTED_CALLS=3
CLONE_SIMILARITY_EXCELLENT_CALLS=12
CLONE_SIMILARITY_EXPECTED_TALK_LOGS=10
CLONE_SIMILARITY_EXCELLENT_TALK_LOGS=40
CLONE_SIMILARITY_VOICE_WEIGHT=0.60
CLONE_SIMILARITY_INTERVIEW_WEIGHT=0.25
CLONE_SIMILARITY_PROFILE_WEIGHT=0.15
CLONE_SIMILARITY_SCORE_FLOOR=55
CLONE_SIMILARITY_ONBOARDING_CAP=64
CLONE_SIMILARITY_SCORE_MAX=92
CLONE_SIMILARITY_SCORING_CEILING=96
CLONE_SIMILARITY_SPEAKER_MODEL=speechbrain/spkrec-ecapa-voxceleb
CLONE_SIMILARITY_COSINE_LOW=0.20
CLONE_SIMILARITY_COSINE_HIGH=0.70
CLONE_SIMILARITY_MAX_ACTUAL_VOICE_SCORE=95
CLONE_SIMILARITY_REFERENCE_TEXT=안녕하세요! 처음뵙겠습니다.
CLONE_SIMILARITY_REFERENCE_AUDIO_DIR=model_calling/assets/clone_similarity
